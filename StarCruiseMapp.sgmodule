#!name=[StarCruise] 自動查分
#!desc=自動查詢分數，只能在船上連上 Star Cruise WiFi 後使用

[Script]
[StarCruise] 自動查分 = type=cron, cronexp="*/5 * * * *", script-path=https://raw.githubusercontent.com/zmLiu1992/AutoPoint/main/StarCruiseAutoPoint.js, wake-system=1, timeout=120

[MITM]
hostname = %APPEND% sdr.scstarnavigator.com